{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "dir": "src" },
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/routes/**",
    "!src/components/**",
    "!src/lib/mock.ts",
    "!src/**/*.glob.ts"
  ],
  "reporters": ["clear-text"],
  "thresholds": { "high": 100, "low": 100, "break": 100 }
}
